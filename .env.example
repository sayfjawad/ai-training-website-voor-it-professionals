# ── Server ───────────────────────────────────────────────────────────────
PORT="3002"
# Where registrations.json lives (mounted on a PVC in k8s)
DATA_DIR="/data"

# ── SMTP (registration confirmation emails) ──────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="my_smtp_username"
SMTP_PASS="my_smtp_password"
# Org inbox: CC'd on every confirmation so we always know someone registered
ORG_EMAIL="info@stichtingduurzaamai.nl"

# ── Admin ("who registered" dashboard at /admin) ─────────────────────────
# Long random secret; required to view /api/admin/* and the /admin page
ADMIN_TOKEN=""
