# ── Server ───────────────────────────────────────────────────────────────
PORT="3002"
# Participation fee in cents (used for the Tikkie amount and email copy)
PRICE_IN_CENTS="7500"
# Where the registrations.json lives (mounted on a PVC in k8s)
DATA_DIR="/data"

# ── SMTP (registration + payment-confirmation emails) ────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="my_smtp_username"
SMTP_PASS="my_smtp_password"
# Org inbox that receives registration + "paid" notifications
ORG_EMAIL="info@stichtingduurzaamai.nl"

# ── Tikkie API v2 (ABN AMRO) ─────────────────────────────────────────────
# Leave API_KEY/APP_TOKEN empty to disable Tikkie and use the shared fallback
# link below (no per-person payment tracking).
TIKKIE_API_KEY=""
TIKKIE_APP_TOKEN=""
# "true" = sandbox (api-sandbox.abnamro.com), "false" = production
TIKKIE_SANDBOX="true"
# Payment request validity + how often we poll Tikkie for paid status
TIKKIE_EXPIRY_DAYS="14"
TIKKIE_POLL_SECONDS="60"
# Backup link shown/emailed if a per-person request can't be created
TIKKIE_FALLBACK_URL="https://tikkie.me/pay/Stichti5519/a1Nih6bHydBzAbyBsn7y64"

# ── Admin ("who paid" dashboard at /admin) ───────────────────────────────
# Long random secret; required to view /api/admin/* and the /admin page
ADMIN_TOKEN=""
